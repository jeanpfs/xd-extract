{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "esModuleInterop": true,
    "types": ["node"],
    "paths": {
      "@xd-extract/core": ["./packages/core/src/index.ts"],
      "@xd-extract/sources": ["./packages/sources/src/index.ts"],
      "@xd-extract/testkit": ["./test-support/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/test", "scripts", "test-support", "vitest.config.ts"]
}
